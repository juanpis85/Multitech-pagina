rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Productos: solo lectura pública, escritura solo admin autenticado
    match /productos/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@multitechcolombia.com';
    }

    // Denegar todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
