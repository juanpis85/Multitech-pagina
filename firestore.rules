rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Productos: solo lectura pública, escritura solo admin autenticado
    match /productos/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email in ['admin@multitechcolombia.com'];
      allow create: if request.auth != null && request.auth.token.email in ['admin@multitechcolombia.com'];
      allow delete: if request.auth != null && request.auth.token.email in ['admin@multitechcolombia.com'];
    }

    // Pedidos: lectura/escritura solo admin
    match /pedidos/{pedidoId} {
      allow read, write: if false;
    }

    // Denegar todo lo demás
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
